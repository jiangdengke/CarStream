# Source this file from a shell after copying it to .env and editing it.
# No camera credentials or SSH password are included in this example.
CARSTREAM_HOST='127.0.0.1'
CARSTREAM_PORT='8080'
CARSTREAM_ACCESS_TOKEN=''
# Private loopback debugging only; never enable for a public deployment.
CARSTREAM_ALLOW_WEAK_TOKEN='false'

# test: synthetic video; rtsp: actual camera (explicit URL required).
CARSTREAM_SOURCE='test'
CARSTREAM_RTSP_URL=''
CARSTREAM_CAMERA_USERNAME=''
CARSTREAM_CAMERA_PASSWORD=''
CARSTREAM_CAMERA_CODEC='h264'
CARSTREAM_ENCODER='auto'
# original: existing resolution / 1500 kbps. low-bandwidth: H.265 -> 720p / 350 kbps.
# H.264 camera passthrough cannot use the low-bandwidth profile.
CARSTREAM_VIDEO_PROFILE='original'

# Example public origin: https://video.example.com (no trailing path).
CARSTREAM_PUBLIC_ORIGIN=''
# STUN/TURN use GStreamer URI syntax, not browser URI syntax.
# Example: stun://stun.example.com:3478
CARSTREAM_STUN_URL=''
# Example: turn://username:password@turn.example.com:3478
# Add ?transport=tcp when client-to-TURN UDP is blocked (or ?transport=udp).
# Percent-encode reserved characters in TURN credentials.
CARSTREAM_TURN_URL=''
# relay requires TURN and can be used to verify that relay works.
CARSTREAM_ICE_POLICY='all'
